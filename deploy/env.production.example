# 复制为 deploy/.env.production 并设为 0600。不要在这里保存密码或 Token。
APP_DOMAIN=toolbox.example.com
APP_VERSION=v1.0.1
APP_TIMEZONE=Asia/Shanghai
POSTGRES_DB=dev_toolbox
POSTGRES_USER=dev_toolbox

# 默认由 gateway/Caddy 直接监听公网 80/443。若主机已有 Nginx，占用这些端口，
# 改为 external_nginx，并填写该 Nginx 容器已经加入的 Docker 网络名。
DEPLOY_EDGE_MODE=caddy
# EDGE_NETWORK_NAME=nginx_default
# EDGE_TRUSTED_PROXY_CIDRS=172.16.0.0/12
# FAIL2BAN_AUTH_LOG_PATH=/home/nginx/logs/access.log

# 二选一：本机挂载的异地目录，或原生 S3 兼容对象存储。不要同时配置。
# 本机路径不能位于本部署目录中。
RESTIC_LOCAL_REPOSITORY_PATH=/absolute/path/to/offsite/dev-toolbox-restic
BACKUP_TARGET_LABEL=异地 restic 仓库
RESTIC_IMAGE=ghcr.io/restic/restic:0.19.1

# S3 示例。Bucket 必须私有且专用于备份；凭据文件仅包含
# AWS_ACCESS_KEY_ID 与 AWS_SECRET_ACCESS_KEY，权限为 0600，不进入 Git。
# 按 Endpoint/Bucket/prefix 填写；脚本使用 DNS-style，实际访问 Bucket.Endpoint。
# RESTIC_REPOSITORY=s3:https://s3.region.example/bucket/dev-toolbox-production
# RESTIC_S3_REGION=region-id
# RESTIC_S3_CREDENTIALS_FILE=/absolute/path/to/secrets/restic_s3.env
# 免费额度为 10,000,000,000 字节时预留 1 GB 给索引、元数据和计量差异；
# 备份前后都会检查，预计超过门禁则失败且不自动删除已有 snapshot。
# RESTIC_REPOSITORY_MAX_BYTES=10000000000
# RESTIC_REPOSITORY_RESERVE_BYTES=1000000000

# 需要把运行数据放到仓库外或执行隔离恢复时，可取消注释并填写绝对路径。
# DEPLOY_DATA_ROOT=/absolute/path/to/dev-toolbox/data
# DEPLOY_SECRETS_ROOT=/absolute/path/to/dev-toolbox/secrets
# DEPLOY_CONFIG_ROOT=/absolute/path/to/dev-toolbox/config
# DEPLOY_STAGING_ROOT=/absolute/path/to/dev-toolbox/backup-staging
