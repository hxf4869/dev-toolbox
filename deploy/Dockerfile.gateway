FROM node:24.20.0-alpine3.23 AS web-build

ARG APP_VERSION=development
ENV VITE_APP_VERSION=$APP_VERSION

RUN corepack enable
WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY patches patches
COPY apps/web/package.json apps/web/package.json
COPY apps/ai-worker/package.json apps/ai-worker/package.json
RUN pnpm install --frozen-lockfile --filter @dev-toolbox/web...
COPY apps/web apps/web
RUN pnpm --filter @dev-toolbox/web build

FROM caddy:2.11.3-alpine

ARG APP_VERSION=development
LABEL org.opencontainers.image.title="dev-toolbox-gateway" \
      org.opencontainers.image.version=$APP_VERSION

COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=web-build /src/apps/web/dist /srv
