# 本文件只列出非敏感配置。复制为 deploy/.env 后按环境修改。
# 正式部署必须使用可解析到本机的 HTTPS 域名；http://localhost 只用于本地开发。
APP_DOMAIN=http://localhost
APP_ORIGIN=http://localhost:8080
HTTP_PORT=8080
HTTPS_PORT=8443
POSTGRES_DB=dev_toolbox
POSTGRES_USER=dev_toolbox

# 密码、应用主密钥和内部服务令牌存放在 deploy/secrets/，不要写入此文件。
# Agent Console 相关：
#   - secrets/agent_console_internal_token：API、gateway（Caddy forward-auth）
#     与未来 relay 共用的内部服务令牌，由 make init-dev / init-production.sh 生成；
#   - AGENT_CONSOLE_RELAY_UPSTREAM：relay 上游地址，默认 agent-console-relay:8081
#     （relay 由 agent-console compose 生产 overlay 以网络别名加入 dev-toolbox_frontend
#     网络，内部监听 8081）。
