limit_req_zone $binary_remote_addr zone=dev_toolbox_login_per_ip:10m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__;
    server_tokens off;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __APP_DOMAIN__;
    server_tokens off;

    ssl_certificate     /etc/nginx/cert/__APP_DOMAIN__.pem;
    ssl_certificate_key /etc/nginx/cert/__APP_DOMAIN__.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 110m;
    limit_req_status 429;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api/v1/auth/login {
        limit_req zone=dev_toolbox_login_per_ip burst=5 nodelay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_pass http://dev-toolbox-gateway:80;
    }

    location ~ ^/api/v1/assistant/(runs/[^/]+/events|temporary/stream)$ {
        proxy_http_version 1.1;
        proxy_read_timeout 65s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass_header X-Accel-Buffering;
        proxy_pass http://dev-toolbox-gateway:80;
    }

    location / {
        proxy_http_version 1.1;
        proxy_read_timeout 65s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_pass http://dev-toolbox-gateway:80;
    }
}
